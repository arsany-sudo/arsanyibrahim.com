# Contact form (Resend) — required for /api/contact to send mail.
# Get a key at https://resend.com → set in Vercel → Settings → Environment Variables.
RESEND_API_KEY=

# Verified sender domain in Resend. Default: site@arsanyibrahim.com
# RESEND_FROM=site@arsanyibrahim.com

# Override the destination address if needed (defaults to arsany@elitecreatif.com).
# CONTACT_TO=arsany@elitecreatif.com
